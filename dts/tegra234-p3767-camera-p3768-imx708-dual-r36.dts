/*
 * Dual-CSI Device Tree Overlay for Sony IMX708 (Raspberry Pi Camera Module 3 / 3 Wide)
 * on Official NVIDIA Jetson Orin Nano Developer Kit (p3768-0000 + p3767-000x).
 *
 * Target: JetPack 6.x (L4T R36.x, Linux 5.15) and JetPack 7.x (L4T R38.x)
 *
 * Hardware mapping on official p3768-0000 carrier board:
 *   CAM0 (J20, i2c@0 via cam_i2cmux):
 *     - CSI interface : CSI-B ("serial_b"), port-index = <1>, 2 data lanes
 *     - Lane polarity : "6" (CSI0_D1 & CSI1_D0 polarity swap on p3768 carrier)
 *     - I2C address   : 0x1a (IMX708 sensor); 0x0c (DW9807V VCM autofocus)
 *     - Reset GPIO    : CAM0_PWDN = TEGRA234_MAIN_GPIO(H, 6) = 62 (0x3e), ACTIVE_HIGH
 *     - Video node    : /dev/video0
 *
 *   CAM1 (J21, i2c@1 via cam_i2cmux):
 *     - CSI interface : CSI-C ("serial_c"), port-index = <2>, 2 data lanes
 *     - Lane polarity : "0" (no lane swap on CSI-C)
 *     - I2C address   : 0x1a (IMX708 sensor); 0x0c (DW9807V VCM autofocus)
 *     - Reset GPIO    : CAM1_PWDN = TEGRA234_MAIN_GPIO(AC, 0) = 160 (0xa0), ACTIVE_HIGH
 *     - Video node    : /dev/video1
 *
 *   I2C mux GPIO:
 *     - CAM_I2C_MUX   : TEGRA234_AON_GPIO(CC, 3) = 19 (0x13), ACTIVE_HIGH
 *   Unused CAM0_RST hog:
 *     - CAM0_RST      : TEGRA234_MAIN_GPIO(H, 3) = 59 (0x3b), output-low
 *
 * Self-contained DTS (no external dt-bindings headers required):
 *   dtc -@ -I dts -O dtb -Wno-unit_address_vs_reg \
 *       -o tegra234-p3767-camera-p3768-imx708-dual-r36.dtbo \
 *       dts/tegra234-p3767-camera-p3768-imx708-dual-r36.dts
 */

/dts-v1/;
/plugin/;

/ {
	overlay-name = "Camera IMX708 Dual (Pi Camera Module 3 Wide)";
	jetson-header-name = "Jetson 24pin CSI Connector";
	compatible = "nvidia,p3768-0000+p3767-0000",
		     "nvidia,p3768-0000+p3767-0001",
		     "nvidia,p3768-0000+p3767-0003",
		     "nvidia,p3768-0000+p3767-0004",
		     "nvidia,p3768-0000+p3767-0005",
		     "nvidia,p3768-0000+p3767-0000-super",
		     "nvidia,p3768-0000+p3767-0001-super",
		     "nvidia,p3768-0000+p3767-0003-super",
		     "nvidia,p3768-0000+p3767-0004-super",
		     "nvidia,p3768-0000+p3767-0005-super";

	fragment@0 {
		target-path = "/";
		__overlay__ {
			tegra-capture-vi {
				status = "okay";
				num-channels = <2>;
				ports {
					#address-cells = <1>;
					#size-cells = <0>;
					port@0 {
						reg = <0>;
						status = "okay";
						rpicam3_imx708_vi_in0: endpoint {
							status = "okay";
							port-index = <1>;
							bus-width = <2>;
							remote-endpoint = <&rpicam3_imx708_csi_out0>;
						};
					};
					port@1 {
						reg = <1>;
						status = "okay";
						rpicam3_imx708_vi_in1: endpoint {
							status = "okay";
							port-index = <2>;
							bus-width = <2>;
							remote-endpoint = <&rpicam3_imx708_csi_out1>;
						};
					};
				};
			};

			tegra-camera-platform {
				compatible = "nvidia, tegra-camera-platform";
				num_csi_lanes = <4>;
				max_lane_speed = <1500000>;
				min_bits_per_pixel = <10>;
				vi_peak_byte_per_pixel = <2>;
				vi_bw_margin_pct = <25>;
				max_pixel_rate = <7500000>;
				isp_peak_byte_per_pixel = <5>;
				isp_bw_margin_pct = <25>;

				modules {
					module0 {
						status = "okay";
						badge = "jakku_front_SC0872";
						position = "front";
						orientation = "1";
						drivernode0 {
							status = "okay";
							pcl_id = "v4l2_sensor";
							sysfs-device-tree = "/sys/firmware/devicetree/base/bus@0/cam_i2cmux/i2c@0/rpicam3_imx708_a@1a";
						};
					};
					module1 {
						status = "okay";
						badge = "jakku_rear_SC0872";
						position = "rear";
						orientation = "1";
						drivernode0 {
							status = "okay";
							pcl_id = "v4l2_sensor";
							sysfs-device-tree = "/sys/firmware/devicetree/base/bus@0/cam_i2cmux/i2c@1/rpicam3_imx708_c@1a";
						};
					};
				};
			};

			bus@0 {
				host1x@13e00000 {
					nvcsi@15a00000 {
						status = "okay";
						num-channels = <2>;
						#address-cells = <1>;
						#size-cells = <0>;
						channel@0 {
							reg = <0>;
							status = "okay";
							ports {
								#address-cells = <1>;
								#size-cells = <0>;
								port@0 {
									reg = <0>;
									status = "okay";
									rpicam3_imx708_csi_in0: endpoint@0 {
										status = "okay";
										port-index = <1>;
										bus-width = <2>;
										remote-endpoint = <&rpicam3_imx708_out0>;
									};
								};
								port@1 {
									reg = <1>;
									status = "okay";
									rpicam3_imx708_csi_out0: endpoint@1 {
										status = "okay";
										remote-endpoint = <&rpicam3_imx708_vi_in0>;
									};
								};
							};
						};
						channel@1 {
							reg = <1>;
							status = "okay";
							ports {
								#address-cells = <1>;
								#size-cells = <0>;
								port@0 {
									reg = <0>;
									status = "okay";
									rpicam3_imx708_csi_in1: endpoint@2 {
										status = "okay";
										port-index = <2>;
										bus-width = <2>;
										remote-endpoint = <&rpicam3_imx708_out1>;
									};
								};
								port@1 {
									reg = <1>;
									status = "okay";
									rpicam3_imx708_csi_out1: endpoint@3 {
										status = "okay";
										remote-endpoint = <&rpicam3_imx708_vi_in1>;
									};
								};
							};
						};
					};
				};

				cam_i2cmux {
					status = "okay";
					compatible = "i2c-mux-gpio";
					#address-cells = <1>;
					#size-cells = <0>;
					/* CAM_I2C_MUX = TEGRA234_AON_GPIO(CC, 3) = 19, GPIO_ACTIVE_HIGH = 0 */
					mux-gpios = <&gpio_aon 19 0>;
					i2c-parent = <&cam_i2c>;

					/* CAM0 (J20, CSI-B / serial_b, port-index 1, lane_polarity 6) */
					i2c@0 {
						status = "okay";
						reg = <0>;
						#address-cells = <1>;
						#size-cells = <0>;

						rbpcv2_imx219_a@10 {
							status = "disabled";
						};

						rpicam3_imx708_a@1a {
							status = "okay";
							compatible = "sony,imx708";
							reg = <0x1a>;
							/* CAM0_PWDN = TEGRA234_MAIN_GPIO(H, 6) = 62, GPIO_ACTIVE_HIGH = 0 */
							reset-gpios = <&gpio 62 0>;
							devnode = "video0";
							physical_w = "6.451";
							physical_h = "3.629";
							sensor_model = "imx708";
							use_sensor_mode_id = "true";

							/* Mode 0: 4608x2592 @ 2..14 fps (Full 12MP Wide FOV) */
							mode0 {
								mclk_khz = "24000";
								num_lanes = "2";
								tegra_sinterface = "serial_b";
								phy_mode = "DPHY";
								discontinuous_clk = "no";
								dpcm_enable = "false";
								cil_settletime = "0";
								lane_polarity = "6";

								active_w = "4608";
								active_h = "2592";
								mode_type = "bayer";
								pixel_phase = "rggb";
								csi_pixel_bit_depth = "10";
								readout_orientation = "90";
								line_length = "4732";
								inherent_gain = "1";
								mclk_multiplier = "7.5";
								pix_clk_hz = "180000000";

								gain_factor = "16";
								framerate_factor = "1000000";
								exposure_factor = "1000000";
								min_gain_val = "18";
								max_gain_val = "256";
								step_gain_val = "1";
								default_gain = "18";
								min_hdr_ratio = "1";
								max_hdr_ratio = "1";
								min_framerate = "2000000";
								max_framerate = "14000000";
								step_framerate = "1";
								default_framerate = "14000000";
								min_exp_time = "210";
								max_exp_time = "498000";
								step_exp_time = "1";
								default_exp_time = "16000";
								embedded_metadata_height = "4";
							};

							/* Mode 1: 2304x1296 @ 2..56 fps (2x2 binned, Full Wide FOV) */
							mode1 {
								mclk_khz = "24000";
								num_lanes = "2";
								tegra_sinterface = "serial_b";
								phy_mode = "DPHY";
								discontinuous_clk = "no";
								dpcm_enable = "false";
								cil_settletime = "0";
								lane_polarity = "6";

								active_w = "2304";
								active_h = "1296";
								mode_type = "bayer";
								pixel_phase = "rggb";
								csi_pixel_bit_depth = "10";
								readout_orientation = "90";
								line_length = "2405";
								inherent_gain = "1";
								mclk_multiplier = "7.5";
								pix_clk_hz = "180000000";

								gain_factor = "16";
								framerate_factor = "1000000";
								exposure_factor = "1000000";
								min_gain_val = "18";
								max_gain_val = "256";
								step_gain_val = "1";
								default_gain = "18";
								min_hdr_ratio = "1";
								max_hdr_ratio = "1";
								min_framerate = "2000000";
								max_framerate = "56000000";
								step_framerate = "1";
								default_framerate = "56000000";
								min_exp_time = "54";
								max_exp_time = "498000";
								step_exp_time = "1";
								default_exp_time = "10000";
								embedded_metadata_height = "4";
							};

							/* Mode 2: 1536x864 @ 2..120 fps (2x2 binned, center cropped) */
							mode2 {
								mclk_khz = "24000";
								num_lanes = "2";
								tegra_sinterface = "serial_b";
								phy_mode = "DPHY";
								discontinuous_clk = "no";
								dpcm_enable = "false";
								cil_settletime = "0";
								lane_polarity = "6";

								active_w = "1536";
								active_h = "864";
								mode_type = "bayer";
								pixel_phase = "rggb";
								csi_pixel_bit_depth = "10";
								readout_orientation = "90";
								line_length = "1658";
								inherent_gain = "1";
								mclk_multiplier = "7.5";
								pix_clk_hz = "180000000";

								gain_factor = "16";
								framerate_factor = "1000000";
								exposure_factor = "1000000";
								min_gain_val = "18";
								max_gain_val = "256";
								step_gain_val = "1";
								default_gain = "18";
								min_hdr_ratio = "1";
								max_hdr_ratio = "1";
								min_framerate = "2000000";
								max_framerate = "120000000";
								step_framerate = "1";
								default_framerate = "120000000";
								min_exp_time = "37";
								max_exp_time = "498000";
								step_exp_time = "1";
								default_exp_time = "5000";
								embedded_metadata_height = "4";
							};

							ports {
								#address-cells = <1>;
								#size-cells = <0>;
								port@0 {
									reg = <0>;
									rpicam3_imx708_out0: endpoint {
										status = "okay";
										port-index = <1>;
										bus-width = <2>;
										remote-endpoint = <&rpicam3_imx708_csi_in0>;
									};
								};
							};
						};
					};

					/* CAM1 (J21, CSI-C / serial_c, port-index 2, lane_polarity 0) */
					i2c@1 {
						status = "okay";
						reg = <1>;
						#address-cells = <1>;
						#size-cells = <0>;

						rbpcv2_imx219_c@10 {
							status = "disabled";
						};

						rpicam3_imx708_c@1a {
							status = "okay";
							compatible = "sony,imx708";
							reg = <0x1a>;
							/* CAM1_PWDN = TEGRA234_MAIN_GPIO(AC, 0) = 160, GPIO_ACTIVE_HIGH = 0 */
							reset-gpios = <&gpio 160 0>;
							devnode = "video1";
							physical_w = "6.451";
							physical_h = "3.629";
							sensor_model = "imx708";
							use_sensor_mode_id = "true";

							/* Mode 0: 4608x2592 @ 2..14 fps (Full 12MP Wide FOV) */
							mode0 {
								mclk_khz = "24000";
								num_lanes = "2";
								tegra_sinterface = "serial_c";
								phy_mode = "DPHY";
								discontinuous_clk = "no";
								dpcm_enable = "false";
								cil_settletime = "0";
								lane_polarity = "0";

								active_w = "4608";
								active_h = "2592";
								mode_type = "bayer";
								pixel_phase = "rggb";
								csi_pixel_bit_depth = "10";
								readout_orientation = "90";
								line_length = "4732";
								inherent_gain = "1";
								mclk_multiplier = "7.5";
								pix_clk_hz = "180000000";

								gain_factor = "16";
								framerate_factor = "1000000";
								exposure_factor = "1000000";
								min_gain_val = "18";
								max_gain_val = "256";
								step_gain_val = "1";
								default_gain = "18";
								min_hdr_ratio = "1";
								max_hdr_ratio = "1";
								min_framerate = "2000000";
								max_framerate = "14000000";
								step_framerate = "1";
								default_framerate = "14000000";
								min_exp_time = "210";
								max_exp_time = "498000";
								step_exp_time = "1";
								default_exp_time = "16000";
								embedded_metadata_height = "4";
							};

							/* Mode 1: 2304x1296 @ 2..56 fps (2x2 binned, Full Wide FOV) */
							mode1 {
								mclk_khz = "24000";
								num_lanes = "2";
								tegra_sinterface = "serial_c";
								phy_mode = "DPHY";
								discontinuous_clk = "no";
								dpcm_enable = "false";
								cil_settletime = "0";
								lane_polarity = "0";

								active_w = "2304";
								active_h = "1296";
								mode_type = "bayer";
								pixel_phase = "rggb";
								csi_pixel_bit_depth = "10";
								readout_orientation = "90";
								line_length = "2405";
								inherent_gain = "1";
								mclk_multiplier = "7.5";
								pix_clk_hz = "180000000";

								gain_factor = "16";
								framerate_factor = "1000000";
								exposure_factor = "1000000";
								min_gain_val = "18";
								max_gain_val = "256";
								step_gain_val = "1";
								default_gain = "18";
								min_hdr_ratio = "1";
								max_hdr_ratio = "1";
								min_framerate = "2000000";
								max_framerate = "56000000";
								step_framerate = "1";
								default_framerate = "56000000";
								min_exp_time = "54";
								max_exp_time = "498000";
								step_exp_time = "1";
								default_exp_time = "10000";
								embedded_metadata_height = "4";
							};

							/* Mode 2: 1536x864 @ 2..120 fps (2x2 binned, center cropped) */
							mode2 {
								mclk_khz = "24000";
								num_lanes = "2";
								tegra_sinterface = "serial_c";
								phy_mode = "DPHY";
								discontinuous_clk = "no";
								dpcm_enable = "false";
								cil_settletime = "0";
								lane_polarity = "0";

								active_w = "1536";
								active_h = "864";
								mode_type = "bayer";
								pixel_phase = "rggb";
								csi_pixel_bit_depth = "10";
								readout_orientation = "90";
								line_length = "1658";
								inherent_gain = "1";
								mclk_multiplier = "7.5";
								pix_clk_hz = "180000000";

								gain_factor = "16";
								framerate_factor = "1000000";
								exposure_factor = "1000000";
								min_gain_val = "18";
								max_gain_val = "256";
								step_gain_val = "1";
								default_gain = "18";
								min_hdr_ratio = "1";
								max_hdr_ratio = "1";
								min_framerate = "2000000";
								max_framerate = "120000000";
								step_framerate = "1";
								default_framerate = "120000000";
								min_exp_time = "37";
								max_exp_time = "498000";
								step_exp_time = "1";
								default_exp_time = "5000";
								embedded_metadata_height = "4";
							};

							ports {
								#address-cells = <1>;
								#size-cells = <0>;
								port@0 {
									reg = <0>;
									rpicam3_imx708_out1: endpoint {
										status = "okay";
										port-index = <2>;
										bus-width = <2>;
										remote-endpoint = <&rpicam3_imx708_csi_in1>;
									};
								};
							};
						};
					};
				};

				gpio@2200000 {
					camera-control-output-low {
						gpio-hog;
						output-low;
						/* CAM0_RST = TEGRA234_MAIN_GPIO(H, 3) = 59 */
						gpios = <59 0>;
						label = "cam0-rst";
					};
				};
			};
		};
	};
};
